# Sao chép file này thành .env rồi điền giá trị (KHÔNG commit .env)

# Khoá OpenAI cho các tính năng AI (tuỳ chọn — có thể nhập trong ⚙️ Cài đặt)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Đồng bộ Thư viện tài liệu lên Google Sheet + Drive (tuỳ chọn)
# URL Apps Script Web App dạng ".../exec" (xem google-apps-script.gs)
GSHEET_WEBHOOK_URL=
# Domain công khai của app (để link ảnh/PDF trong Sheet là link đầy đủ), vd https://your-app.onrender.com
PUBLIC_URL=

# Cổng (tuỳ chọn; mặc định 3000)
PORT=
